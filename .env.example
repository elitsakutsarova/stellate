EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
# Only used as a fallback for a real (non-development) build, where there's
# no Metro dev server to auto-detect the LAN IP from. Set this to the
# server's real deployed URL once it's hosted somewhere.
EXPO_PUBLIC_API_URL=http://localhost:3000
